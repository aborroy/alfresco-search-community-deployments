# Image tags and demo credentials shared by every deployment variant.
#
# Compose only auto-loads a .env file from the directory of the compose file, so each
# variant carries a `.env` symlink pointing here. If your platform does not support
# symlinks (Windows without developer mode), run Compose with an explicit flag instead:
#
#   docker compose --env-file ../.env up -d

# --- Alfresco Content Services Community 26.2 ---
ALFRESCO_TAG=26.2.0
SHARE_TAG=26.2.1
ACA_TAG=8.0.0
TRANSFORM_TAG=5.4.3

# --- Alfresco Search Community ---
# The batch indexing application that feeds the search index.
BATCH_INDEXER_TAG=5.7.1

# --- Search backends ---
# OpenSearch 3.x also works; see docs/hxpr-coexistence.md.
OPENSEARCH_TAG=2.19.6
OPENSEARCH_DASHBOARDS_TAG=2.19.6
# Only used by solr-to-opensearch-migration, as the engine being migrated away from.
SEARCH_SERVICES_TAG=2.0.21

# --- Infrastructure ---
POSTGRES_TAG=17.9
NGINX_TAG=stable-alpine

# --- Database ---
DB_NAME=alfresco
DB_USER=alfresco
DB_PASSWORD=alfresco

# --- Shared secret between the repository and the search tier ---
# Guards /alfresco/service/api/solr/textContent, the text extraction endpoint the batch
# indexer calls. The repository property `solr.sharedSecret` and the indexer variable
# ALFRESCO_CONTENT_TRANSFORM_SHAREDSECRET must hold the same value.
# CHANGE THIS outside of throwaway demos.
SHARED_SECRET=demosecret

# --- OpenSearch credentials, used by minimal-tls only ---
# The other variants run OpenSearch with the security plugin disabled and need no
# credentials. CHANGE THIS outside of throwaway demos.
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=DemoTls13!Pass

# --- Truststore password, used by minimal-tls only ---
# Applied to both generated truststores by generate-certs.sh.
TRUSTSTORE_PASSWORD=changeit

# --- Host binding, used by full-stack only ---
SERVER_NAME=localhost
BIND_IP=0.0.0.0

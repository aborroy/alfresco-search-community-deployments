# Generated demo PKI. Never commit private keys, not even throwaway ones.
# Recreate with minimal-tls/generate-certs.sh.
minimal-tls/certs/

# Namespace prefix maps fetched by tools/fetch-prefix-map.sh. They describe one repository's
# dictionary, so they belong to that installation rather than to this repository.
*/config/prefixes.json

# Third-party addon JARs downloaded by hand, and whatever is dropped into the full-stack
# extension directories. Nothing is vendored here.
tools/addons/
full-stack/alfresco/modules/jars/*.jar
full-stack/alfresco/modules/amps/*.amp

# Nothing writes here: stateful data lives in named volumes and logs go to stdout. Ignored so a
# stray bind mount cannot end up committed.
full-stack/data/
full-stack/logs/

# The shared .env at the repository root IS tracked on purpose: it holds pinned image tags
# and clearly-labelled demo credentials, nothing sensitive. Local overrides are not.
.env.local
*.env.local

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
